# Development settings for the shop server. Copy to .env (never committed) and run
# `php artisan key:generate`. The database settings come from compose.yaml at the
# repository root. A shop's real settings come from its install profile, not this file.

APP_NAME="HAQ Retail OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only. compose.yaml sets DB_HOST, DB_DATABASE, DB_USERNAME and DB_PASSWORD
# for the containers, and those win over this file.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=retail
DB_USERNAME=retail
DB_PASSWORD=

# Sessions, jobs and the cache live in PostgreSQL: there is no Redis (spec section 4).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# A shop server sends no email.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
