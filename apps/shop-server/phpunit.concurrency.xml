<?xml version="1.0" encoding="UTF-8"?>
<!--
    The multi-process suite (spec section 14) [F6]: concurrency, crash and restore tests. Each test runs
    real worker processes against a real PostgreSQL, with committed transactions; RefreshDatabase and
    DatabaseTransactions are never used here. It has its own database, retail_concurrency, so its
    committed rows never meet the feature tests.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Cheaper Argon2id for tests only; shops use the full cost. -->
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="retail_concurrency" force="true"/>
        <!-- Laravel reads $_SERVER before $_ENV, and the containers set DB_DATABASE in the real
             environment, so the database is forced in $_SERVER too. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="retail_concurrency" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="AUDIT_SPOOL" value="storage/framework/testing/concurrency-spool.jsonl" force="true"/>
        <server name="AUDIT_SPOOL" value="storage/framework/testing/concurrency-spool.jsonl" force="true"/>
        <env name="BRANCH_KEY_DIR" value="storage/framework/testing/concurrency-keys" force="true"/>
        <server name="BRANCH_KEY_DIR" value="storage/framework/testing/concurrency-keys" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
