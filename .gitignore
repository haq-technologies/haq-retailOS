# macOS
.DS_Store

# Editors and IDEs
.idea/
.vscode/
*.swp

# Office lock files
~$*

# Python
__pycache__/
*.pyc

# Dependencies and build output (once the code exists)
/vendor/
/node_modules/
/public/build/

# Secrets and local environment: never commit these
# Shop profiles hold shop data (names, addresses, phone numbers)
# The install folder's secrets are made on the server, never in the repository
apps/shop-server/deploy/secrets/
*.profile.json
/profiles/
.env
.env.*
!.env.example
*.pem
# The release public key is the one key that belongs in the repository (D36).
!apps/shop-server/deploy/release-public.pem
*.key

# Release folders made by tools/release/make-manifest.sh: published as GitHub releases, never committed.
/release/

# The release signing key never enters the repository (D36); only release-public.pem is committed.
release-private.pem
